<mxfile host="app.diagrams.net"><diagram id="phase1" name="Phase I – Business Process"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Rwanda Food Price Watch&lt;/b&gt; – Monthly Market Price Collection, Validation &amp;amp; Spike Alert Process (BPMN 2.0) · Bruce RUTAGENGWA · 28468" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1400" height="36" as="geometry"/></mxCell><mxCell id="pool" value="Food Price Monitoring" style="swimlane;html=1;startSize=30;horizontal=0;fontSize=13;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="3620" height="980" as="geometry"/></mxCell><mxCell id="lane1" value="Market Price&lt;br&gt;Enumerator" style="swimlane;html=1;startSize=30;horizontal=0;fontSize=12;whiteSpace=wrap;swimlaneFillColor=#ffffff;" vertex="1" parent="pool"><mxGeometry x="30" y="0" width="3590" height="140" as="geometry"/></mxCell><mxCell id="lane2" value="Data Entry Officer" style="swimlane;html=1;startSize=30;horizontal=0;fontSize=12;whiteSpace=wrap;swimlaneFillColor=#fafafa;" vertex="1" parent="pool"><mxGeometry x="30" y="140" width="3590" height="220" as="geometry"/></mxCell><mxCell id="lane3" value="Price Watch System&lt;br&gt;(Oracle DB + PL/SQL)" style="swimlane;html=1;startSize=30;horizontal=0;fontSize=12;whiteSpace=wrap;swimlaneFillColor=#ffffff;" vertex="1" parent="pool"><mxGeometry x="30" y="360" width="3590" height="240" as="geometry"/></mxCell><mxCell id="lane4" value="Food Security Analyst" style="swimlane;html=1;startSize=30;horizontal=0;fontSize=12;whiteSpace=wrap;swimlaneFillColor=#fafafa;" vertex="1" parent="pool"><mxGeometry x="30" y="600" width="3590" height="220" as="geometry"/></mxCell><mxCell id="lane5" value="District Agriculture Officer" style="swimlane;html=1;s