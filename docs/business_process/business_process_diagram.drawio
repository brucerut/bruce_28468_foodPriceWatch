usive;fontSize=10;fontStyle=1;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1995" y="445" width="50" height="50" as="geometry"/></mxCell><mxCell id="T11" value="Create price alert (status OPEN)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[C]&lt;/b&gt; PRICE_ALERT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1950" y="535" width="140" height="70" as="geometry"/></mxCell><mxCell id="T12" value="Refresh Power BI dashboard data&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[R]&lt;/b&gt; PRICE_OBSERVATION, PRICE_ALERT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2120" y="435" width="140" height="70" as="geometry"/></mxCell><mxCell id="T13" value="Review open alerts on the dashboard&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[R]&lt;/b&gt; PRICE_ALERT, PRICE_OBSERVATION&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2290" y="665" width="140" height="70" as="geometry"/></mxCell><mxCell id="G5" value="Genuine price&lt;br&gt;spike?" style="shape=mxgraph.bpmn.gateway2;html=1;labelPosition=left;verticalLabelPosition=top;verticalAlign=bottom;align=right;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fontSize=10;fontStyle=1;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="2505" y="675" width="50" height="50" as="geometry"/></mxCell><mxCell id="T14" value="Mark alert FALSE_ALARM and request correction&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;[U]&lt;/b&gt; PRICE_ALERT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x=